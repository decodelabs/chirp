{
    "name": "decodelabs/chirp",
    "description": "Tweet parser",
    "type": "library",
    "keywords": [
        "tweet",
        "twitter",
        "markup",
        "html"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        }
    ],
    "require": {
        "php": "^8.4",

        "decodelabs/tagged": "^0.21"
    },
    "require-dev": {
        "decodelabs/chorus": "^0.1",
        "decodelabs/metamorph": "^0.8",
        "decodelabs/phpstan-decodelabs": "^0.7"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\Chirp\\": "src/Chirp",
            "DecodeLabs\\Metamorph\\Handler\\": "src/Metamorph"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.10.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
